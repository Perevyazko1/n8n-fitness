    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT\n  (SELECT count(*) FROM vocab_progress WHERE chat_id = {{ $json.chat_id }}) AS started,\n  (SELECT count(*) FROM vocab_progress WHERE chat_id = {{ $json.chat_id }} AND learned_at IS NOT NULL) AS learned,\n  (SELECT count(*) FROM vocab_progress WHERE chat_id = {{ $json.chat_id }} AND next_review <= CURRENT_DATE) AS due_now,\n  (SELECT count(*) FROM vocab_progress WHERE chat_id = {{ $json.chat_id }} AND next_review = CURRENT_DATE + 1) AS due_tomorrow,\n  (SELECT count(*) FROM vocab_word) AS total_words,\n  COALESCE((SELECT streak FROM vocab_user WHERE chat_id = {{ $json.chat_id }}), 0) AS streak;",
        "options": {}
      },
