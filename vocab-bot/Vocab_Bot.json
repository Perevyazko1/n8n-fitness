    {
      "parameters": {
        "jsCode": "// Собираем утреннее сообщение: карточки слов + история от ИИ.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst batch = $('Group Batch').item.json;\nconst story = $json.message?.content ?? $json.content ?? $json.text ?? $json.output ?? '';\n\nconst cards = batch.words\n  .map(w => `${w.id}. <b>${esc(w.word)}</b> [${esc(w.ipa || '')}] — ${esc(w.translation)}`)\n  .join('\\n');\n\nconst text = `<b>Слова дня</b>\\n\\n${cards}\\n\\n<b>Маша в Лондоне</b>\\n${esc(story).trim()}\\n\\n` +\n             `Вечером спрошу их обратно. Проверить себя раньше — /test`;\n\nreturn [{ json: { chat_id: batch.chat_id, text } }];"
      },
