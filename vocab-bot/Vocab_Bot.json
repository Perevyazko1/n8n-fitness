    {
      "parameters": {
        "jsCode": "// Ответ на присланный перевод: вердикт + следующий вопрос либо итог сессии.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst v = $('Apply Verdict').first().json;\nconst a = $('Advance Session').first().json;\n\nconst head = v.verdict === 'ok'   ? '✅ Верно'\n           : v.verdict === 'typo' ? '☑️ Верно, но с опечаткой'\n           :                        `❌ Мимо. <b>${esc(v.word)}</b> — ${esc(v.translation)}`;\nlet text = v.comment ? `${head}\\n${esc(v.comment)}` : head;\n\nconst finished = !a.current;\nif (finished) {\n  text += `\\n\\n<b>Готово: ${a.correct} из ${a.total}</b>`;\n  if (a.wrong_list) text += `\\n\\nВернёмся к этим завтра:\\n${esc(a.wrong_list)}`;\n} else {\n  text += a.next_mode === 'ru_en'\n    ? `\\n\\nКак по-английски: <b>${esc(a.translation)}</b>?`\n    : `\\n\\nПереведи: <b>${esc(a.word)}</b> [${esc(a.ipa || '')}]`;\n}\nreturn [{ json: { chat_id: v.chat_id, text, finished } }];"
      },
