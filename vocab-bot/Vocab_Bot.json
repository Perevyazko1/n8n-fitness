      "parameters": {
        "jsCode": "// Разбираем апдейт: команда или ответ на вопрос теста.\n// Бот личный — на всё, что пришло не от владельца, не реагируем вообще.\nconst OWNER_CHAT_ID = 648226895;\nconst m = $json.message || {};\nif (m.chat?.id !== OWNER_CHAT_ID) return [];\nconst text = (m.text || '').trim();\nconst cmd = text.startsWith('/') ? text.split(/[\\s@]/)[0].toLowerCase() : '';\nreturn [{ json: {\n  chat_id: m.chat?.id,\n  username: m.from?.username || null,\n  text,\n  cmd,\n}}];"
