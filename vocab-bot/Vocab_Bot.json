    {
      "parameters": {
        "jsCode": "// Схлопываем плоский список слов в один item на чат.\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst byChat = new Map();\nfor (const r of rows) {\n  if (!byChat.has(r.chat_id)) byChat.set(r.chat_id, []);\n  byChat.get(r.chat_id).push(r);\n}\nconst out = [];\nfor (const [chat_id, words] of byChat) {\n  out.push({ json: {\n    chat_id,\n    words,\n    // для промпта — просто перечисление\n    word_list: words.map(w => `${w.word} — ${w.translation}`).join('\\n'),\n  }});\n}\n// Пусто = у юзера кончились новые слова (все 1000 разобраны) — тихо выходим.\nreturn out;"
      },
