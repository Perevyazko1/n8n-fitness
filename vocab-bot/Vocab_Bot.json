        "query": "=INSERT INTO vocab_session (chat_id, queue, current, mode, correct, total, wrong_ids, started_at)\nVALUES ({{ $json.chat_id }}, '{{ JSON.stringify($json.queue) }}'::jsonb,\n        {{ $json.current }}, '{{ $json.mode }}', 0, 0, '[]'::jsonb, now())\nON CONFLICT (chat_id) DO UPDATE SET\n    queue = EXCLUDED.queue, current = EXCLUDED.current, mode = EXCLUDED.mode,\n    correct = 0, total = 0, wrong_ids = '[]'::jsonb, started_at = now()\nRETURNING chat_id, current, mode;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
