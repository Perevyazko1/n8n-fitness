    {
      "parameters": {
        "jsCode": "// Разбираем вердикт судьи. typo считаем успехом, но покажем правильное написание.\nconst raw = $json.message?.content ?? $json.content ?? $json.text ?? $json.output ?? '';\nlet v = { verdict: 'wrong', comment: '' };\ntry {\n  v = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  // Судья ответил не-JSON — не наказываем ученика за нашу ошибку, считаем верным.\n  v = { verdict: 'ok', comment: '' };\n}\nconst s = $('Load Session').first().json;\nconst ok = v.verdict !== 'wrong';\nreturn [{ json: {\n  chat_id: s.chat_id,\n  word_id: s.current,\n  mode: s.mode,\n  word: s.word,\n  translation: s.translation,\n  verdict: v.verdict,\n  comment: v.comment || '',\n  ok,\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        400
      ],
      "id": "apply-verdict",
      "name": "Apply Verdict"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE vocab_progress SET\n    box = CASE WHEN {{ $json.ok }} THEN LEAST(box + 1, 6) ELSE 0 END,\n    next_review = vocab_next_review((CASE WHEN {{ $json.ok }} THEN LEAST(box + 1, 6) ELSE 0 END)::smallint),\n    lapses = lapses + CASE WHEN {{ $json.ok }} THEN 0 ELSE 1 END,\n    last_result = '{{ $json.verdict }}',\n    learned_at = CASE\n        WHEN {{ $json.ok }} AND '{{ $json.mode }}' = 'ru_en' AND box >= 4 THEN COALESCE(learned_at, now())\n        ELSE learned_at END,\n    updated_at = now()\n WHERE chat_id = {{ $json.chat_id }} AND word_id = {{ $json.word_id }}\nRETURNING chat_id, word_id, box, next_review;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1380,
        400
      ],
      "id": "update-progress",
      "name": "Update Progress",
      "credentials": {
        "postgres": {
          "id": "1Vpr6VdwzI4rfpHh",
          "name": "PG"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH adv AS (\n  UPDATE vocab_session s SET\n      current   = (s.queue ->> 0)::smallint,\n      queue     = COALESCE(s.queue #- '{0}', '[]'::jsonb),\n      correct   = s.correct + CASE WHEN {{ $('Apply Verdict').first().json.ok }} THEN 1 ELSE 0 END,\n      total     = s.total + 1,\n      wrong_ids = CASE WHEN {{ $('Apply Verdict').first().json.ok }} THEN s.wrong_ids\n                       ELSE s.wrong_ids || to_jsonb({{ $('Apply Verdict').first().json.word_id }}::int) END\n   WHERE s.chat_id = {{ $('Apply Verdict').first().json.chat_id }}\n  RETURNING s.chat_id, s.current, s.correct, s.total, s.wrong_ids\n)\nSELECT a.chat_id, a.current, a.correct, a.total, a.wrong_ids,\n       w.word, w.ipa, w.translation,\n       CASE WHEN COALESCE(p.box, 0) <= 2 THEN 'en_ru' ELSE 'ru_en' END AS next_mode,\n       (SELECT string_agg(x.word || ' — ' || x.translation, E'\\n')\n          FROM vocab_word x\n         WHERE x.id = ANY (SELECT jsonb_array_elements_text(a.wrong_ids)::int)) AS wrong_list\n  FROM adv a\n  LEFT JOIN vocab_word w ON w.id = a.current\n  LEFT JOIN vocab_progress p ON p.chat_id = a.chat_id AND p.word_id = a.current;",
        "options": {}
      },
