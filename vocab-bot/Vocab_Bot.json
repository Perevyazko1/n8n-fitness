    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH picked AS (\n  SELECT w.id\n    FROM vocab_word w\n   WHERE NOT EXISTS (\n         SELECT 1 FROM vocab_progress p\n          WHERE p.chat_id = {{ $json.chat_id }} AND p.word_id = w.id)\n   ORDER BY w.id\n   LIMIT (SELECT daily_new FROM vocab_user WHERE chat_id = {{ $json.chat_id }})\n), ins AS (\n  INSERT INTO vocab_progress (chat_id, word_id, box, next_review)\n  SELECT {{ $json.chat_id }}, id, 0, CURRENT_DATE + 1 FROM picked\n  ON CONFLICT (chat_id, word_id) DO NOTHING\n  RETURNING word_id\n)\nSELECT {{ $json.chat_id }}::bigint AS chat_id, w.id, w.word, w.ipa, w.translation\n  FROM vocab_word w\n  JOIN ins ON ins.word_id = w.id\n ORDER BY w.id;",
        "options": {}
