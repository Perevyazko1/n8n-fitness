    {
      "parameters": {
        "jsCode": "// Из списка «пора повторить» делаем очередь вопросов.\n// box <= 2 — спрашиваем EN→RU (узнавание), дальше RU→EN (вспоминание, сложнее).\nconst rows = $input.all().map(i => i.json).filter(r => r && r.word_id);\nconst byChat = new Map();\nfor (const r of rows) {\n  if (!byChat.has(r.chat_id)) byChat.set(r.chat_id, []);\n  byChat.get(r.chat_id).push(r);\n}\nconst out = [];\nfor (const [chat_id, items] of byChat) {\n  const ids = items.map(i => i.word_id);\n  const first = items[0];\n  out.push({ json: {\n    chat_id,\n    current: first.word_id,\n    mode: first.box <= 2 ? 'en_ru' : 'ru_en',\n    queue: ids.slice(1),\n    total_planned: ids.length,\n  }});\n}\nreturn out;"
      },
