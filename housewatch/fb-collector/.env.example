# Скопировать в .env (он в .gitignore) и заполнить.
# Production-URL вебхука из ноды «FB Webhook» воркфлоу HouseWatch_FB.
HW_FB_WEBHOOK=https://n8n-fitness.ru/webhook/housewatch-fb
# Тот же секрет, что в credential «HouseWatch FB token» (Header Auth, имя заголовка X-HW-Token).
HW_FB_TOKEN=
# Необязательное:
# HW_FB_HEADLESS=0        # 0 — показывать окно Chrome (если FB начнёт капризничать в headless)
# HW_FB_HOURS=8-23        # часы работы по времени Mac
# HW_FB_INTERVAL_MIN=30   # минимум между поисками
# HW_FB_SCROLLS=3         # прокруток на группу (после сна — больше, до HW_FB_MAX_SCROLLS=25)
# HW_FB_MAX_OPEN=15
# HW_FB_PROFILE=/Users/you/.housewatch-fb-profile
