    {
      "id": "Nav_Find",
      "name": "Find Sibling Topic",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -180,
        860
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cur AS (SELECT topic_id FROM ryzh_posts WHERE id = $1)\nSELECT t.id\nFROM ryzh_topics t, cur\nWHERE ( $2 = 'next' AND t.id > cur.topic_id\n     OR $2 = 'prev' AND t.id < cur.topic_id )\n  AND ( t.status IN ('queued', 'skipped')\n     OR t.status = 'proposed' AND t.created_at > now() - interval '14 days' )\nORDER BY CASE WHEN $2 = 'next' THEN t.id END ASC,\n         CASE WHEN $2 = 'prev' THEN t.id END DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $('Route').item.json.post_id, $('Route').item.json.dir ] }}"
        }
      },
      "credentials": {
