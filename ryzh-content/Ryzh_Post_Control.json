    {
      "id": "Parse_Rewrite",
      "name": "Parse Rewrite",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function extractText(j) {\n  if (Array.isArray(j.output)) {\n    for (const o of j.output) {\n      const part = Array.isArray(o.content) && o.content.find(c => c.text);\n      if (part?.text) return part.text;\n    }\n  }\n  if (Array.isArray(j.content)) {\n    const part = j.content.find(c => c.text);\n    if (part?.text) return part.text;\n  }\n  return j.message?.content ?? j.content ?? j.text ?? '';\n}\nconst raw = String(extractText($input.first().json) || '').trim();\nconst body = raw.replace(/^```(?:html)?\\s*/i, '').replace(/```\\s*$/, '').trim();\nif (!body) throw new Error('LLM вернул пустой текст при переписывании');\nreturn [{ json: { body } }];\n"
      }
    },
