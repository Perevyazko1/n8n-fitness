    {
      "id": "Caption_v2",
      "name": "Caption (v2)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const RUBRICS = { check: 'Рыж проверяет', price: 'Почём белок', recipe: 'Рецепт Рыжа', guess: 'На глаз', swap: 'Вместо этого', tried: 'Рыж пробует', fox: 'Лис' };\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst plain = s => String(s ?? '').replace(/<[^>]+>/g, '').replace(/&(lt|gt|amp|quot);/g, '_');\nfunction buildCaption(c) {\n  const head = `<b>#${c.post_id}</b> · ${esc(RUBRICS[c.rubric] || c.rubric || '—')} · v${c.version}\\n<i>${esc(c.title)}</i>\\n\\n`;\n  const len = plain(c.body).length;\n  if (plain(head + c.body).length <= 1024) return { caption: head + c.body, fits: true, len };\n  const note = `<b>#${c.post_id}</b> ⚠️ ${len} зн. — длиннее подписи (1024). Ответь «сократи до 800».\\n\\n`;\n  return { caption: note + esc(plain(c.body).slice(0, 850)) + '…', fits: false, len };\n}\n\nconst f = $('Find Draft').first().json;\nconst c = { post_id: $json.id, title: f.title, rubric: f.rubric,\n            body: $('Parse Rewrite').first().json.body, version: $json.version };\nreturn [{ json: { ...c, ...buildCaption(c) } }];"
      }
    },
