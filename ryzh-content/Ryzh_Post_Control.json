      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id, p.body, p.rubric, p.version, p.image_file_id,\n       coalesce(t.title, '') AS title\nFROM ryzh_posts p LEFT JOIN ryzh_topics t ON t.id = p.topic_id\nWHERE p.status = 'draft'\n  AND ($1::bigint IS NULL OR EXISTS (\n        SELECT 1 FROM ryzh_approvals a\n        WHERE a.post_id = p.id AND a.chat_id = $2 AND a.message_id = $1))\nORDER BY p.id DESC\nLIMIT 1;",
        "options": {
