      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Единая точка входа бота канала Рыжа. Кто редактор — решает следующая нода\n// (таблица ryzh_editors), здесь только разбор апдейта.\n// Три случая: нажата кнопка черновика; текст-правка (reply на черновик или просто текст);\n// всё остальное — подсказка.\nconst j = $input.first().json;\n\nconst cq = j.callback_query;\nif (cq) {\n  const [act, id] = (cq.data || '').split(':');\n  if (!['pok','pno','pnx','ppv','pim'].includes(act)) return [];\n  return [{ json: {\n    kind: act === 'pok' ? 'approve' : act === 'pno' ? 'reject' : act === 'pim' ? 'redraw' : 'nav',\n    dir: act === 'pnx' ? 'next' : act === 'ppv' ? 'prev' : null,\n    post_id: Number(id),\n    chat_id: cq.from.id,\n    by: cq.from.first_name || cq.from.username || String(cq.from.id),\n    callback_query_id: cq.id,\n    message_id: cq.message?.message_id ?? null,\n  }}];\n}\n\nconst m = j.message || {};\nif (!m.from || m.chat?.type !== 'private') return [];  // только личка\n\nconst text = (m.text || '').trim();\nif (!text || text.startsWith('/')) {\n  return [{ json: { kind: 'help', chat_id: m.from.id } }];\n}\n\n// Правка. Если это ответ на сообщение с черновиком — привязываемся к нему точно,\n// иначе правим последний висящий черновик.\nreturn [{ json: {\n  kind: 'edit',\n  chat_id: m.from.id,\n  edit_note: text,\n  reply_to: m.reply_to_message?.message_id ?? null,\n}}];\n"
      }
    },
