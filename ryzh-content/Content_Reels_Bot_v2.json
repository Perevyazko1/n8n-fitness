  {
   "id": "Collect_Handler",
   "name": "Collect Handler",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    640
   ],
   "parameters": {
    "jsCode": "// Копим мемы (K = число 'mem' в формате), затем ждём голос. action -> куда дальше.\nconst j = $json;\nconst fmt = (j.fmt || '').split(',').filter(Boolean);\nconst K = fmt.filter(t => t === 'mem').length;\nconst draft = j.draft || {};\ndraft.mems = draft.mems || [];\nif (j.mem_file) {\n  if (draft.mems.length >= K) return [{ json: { action: 'nag', chat_id: j.chat_id, text: 'Мемы уже собраны. Пришли голосовое с описанием.' } }];\n  draft.mems.push(j.mem_file);\n  const left = K - draft.mems.length;\n  const text = left > 0 ? ('Мем сохранён (' + draft.mems.length + '/' + K + '). Пришли ещё ' + left + '.')\n                        : 'Все мемы собраны. Теперь пришли голосовое с описанием.';\n  return [{ json: { action: 'save', chat_id: j.chat_id, draft, text } }];\n}\nif (j.voice_file) {\n  if (draft.mems.length < K) return [{ json: { action: 'nag', chat_id: j.chat_id, text: 'Сначала пришли мем(ы): ' + draft.mems.length + '/' + K + '.' } }];\n  draft.voice_file = j.voice_file;\n  return [{ json: { action: 'transcribe', chat_id: j.chat_id, draft, voice_file: j.voice_file } }];\n}\nreturn [{ json: { action: 'nag', chat_id: j.chat_id, text: 'Пришли мем (видео/картинку) или голосовое с описанием.' } }];\n"
   }
  },
