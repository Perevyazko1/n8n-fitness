  {
   "id": "Prep",
   "name": "Prep",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -60,
    360
   ],
   "parameters": {
    "jsCode": "// Владелец-гейт + вытащить chat_id (для загрузки сессии) и сырой апдейт.\nconst OWNER = 648226895;\nconst cq = $json.callback_query;\nif (cq) {\n  if (cq.from?.id !== OWNER) return [];\n  return [{ json: { chat_id: cq.from.id, is_cb: true, cb_data: cq.data || '', cq_id: cq.id } }];\n}\nconst m = $json.message || {};\nif (m.from?.id !== OWNER) return [];\nreturn [{ json: { chat_id: m.from.id, is_cb: false, cb_data: '', msg: m } }];\n"
   }
  },
  {
   "id": "Load_Session",
   "name": "Load Session",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    140,
    360
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT chat_id, step, fmt, mem_kind, draft FROM reels_session WHERE chat_id = $1;",
    "options": {
     "queryReplacement": "={{ [$json.chat_id] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "1Vpr6VdwzI4rfpHh",
     "name": "PG"
    }
   },
   "alwaysOutputData": true
  },
  {
   "id": "Route",
   "name": "Route",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    340,
    360
   ],
   "parameters": {
    "jsCode": "// Роутер с учётом шага сессии. upd — сырой апдейт (Prep), s — строка сессии (может быть пустой).\nconst upd = $('Prep').first().json;\nconst s = $json || {};\nconst step = s.step || 'idle';\nif (upd.is_cb) {\n  const d = upd.cb_data || '';\n  if (d.startsWith('fmt:'))  return [{ json: { kind: 'pick_format',  chat_id: upd.chat_id, fmt: d.slice(4),      cq_id: upd.cq_id } }];\n  if (d.startsWith('mem:'))  return [{ json: { kind: 'pick_memtype', chat_id: upd.chat_id, mem_kind: d.slice(4), cq_id: upd.cq_id } }];\n  if (d.startsWith('ok:'))   return [{ json: { kind: 'approve',  chat_id: upd.chat_id, script_id: Number(d.slice(3)), cq_id: upd.cq_id } }];\n  if (d.startsWith('edit:')) return [{ json: { kind: 'edit_req', chat_id: upd.chat_id, script_id: Number(d.slice(5)), cq_id: upd.cq_id } }];\n  if (d.startsWith('no:'))   return [{ json: { kind: 'reject',   chat_id: upd.chat_id, script_id: Number(d.slice(3)), cq_id: upd.cq_id } }];\n  return [];\n}\nconst m = upd.msg || {};\nif (step === 'collect') {\n  let mem_file = null, mem_is_img = false, voice_file = null;\n  if (m.voice) voice_file = m.voice.file_id;\n  else if (m.video) mem_file = m.video.file_id;\n  else if (m.animation) mem_file = m.animation.file_id;\n  else if (m.document && (m.document.mime_type || '').startsWith('video')) mem_file = m.document.file_id;\n  else if (m.photo) { mem_file = m.photo[m.photo.length - 1].file_id; mem_is_img = true; }\n  return [{ json: { kind: 'collect', chat_id: upd.chat_id, fmt: s.fmt, mem_kind: s.mem_kind,\n                    draft: s.draft || {}, mem_file, mem_is_img, voice_file } }];\n}\nif (step === 'edit') {  // ждём текст-правку к сценарию\n  return [{ json: { kind: 'edit_comment', chat_id: upd.chat_id, comment: (m.text || '').trim(),\n                    script_id: s.draft?.script_id } }];\n}\nreturn [{ json: { kind: 'start', chat_id: upd.chat_id } }];\n"
   }
  },
