  {
   "id": "Parse_Scenario",
   "name": "Parse Scenario",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1800,
    860
   ],
   "parameters": {
    "jsCode": "// Разбор ответа LLM (Responses-формат), подстановка мемов по порядку, RU-превью.\nfunction extractText(j) {\n  if (Array.isArray(j.output)) for (const o of j.output) {\n    const p = Array.isArray(o.content) && o.content.find(c => c.text); if (p?.text) return p.text; }\n  if (Array.isArray(j.content)) { const p = j.content.find(c => c.text); if (p?.text) return p.text; }\n  return j.message?.content ?? j.content ?? j.text ?? '';\n}\nlet s = String(extractText($json)).trim().replace(/^```(json)?/i, '').replace(/```$/, '').trim();\nlet obj; try { obj = JSON.parse(s); } catch (e) { throw new Error('LLM не-JSON: ' + s.slice(0, 300)); }\n\nconst route = $('Route').first().json;\nconst memKind = route.mem_kind || 'video';\nconst mems = ($('Collect Handler').first().json.draft?.mems) || [];\nlet mi = 0;\nconst timeline = (obj.timeline || []).map(seg => {\n  if (seg.type === 'mem') {\n    const fid = mems[mi++];\n    return memKind === 'image' ? { type: 'image', tg_file_id: fid, duration: 3 }\n                               : { type: 'clip',  tg_file_id: fid, keep_audio: true };\n  }\n  return seg; // ai: line/action/desc_ru/duration\n});\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lines = timeline.map((s2, i) => {\n  const n = i + 1;\n  if (s2.type === 'ai')    return n + '. Рыж: «' + (s2.line || '') + '»' + (s2.desc_ru ? ' — ' + s2.desc_ru : '');\n  if (s2.type === 'image') return n + '. мем (картинка)';\n  return n + '. мем (видео)';\n}).join('\\n');\nconst msg = '<b>Хук:</b> ' + esc(obj.hook || '') + '\\n<b>Caption:</b> ' + esc(obj.caption || '') +\n            '\\n\\n<b>Сценарий:</b>\\n' + esc(lines);\nreturn [{ json: {\n  chat_id: $('Collect Handler').first().json.chat_id,\n  hook: obj.hook || '', caption: obj.caption || '', hashtags: obj.hashtags || '', theme: obj.theme || '',\n  timeline, msg,\n}}];\n"
   }
  },
