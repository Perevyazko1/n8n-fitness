        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ model: 'gpt-image-2', prompt: $json.prompt, size: $json.size, quality: $json.quality, n: 1 }, $json.background ? { background: $json.background } : {})) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "SkPovYGQlL1P1Ft5",
