    {
      "id": "To_Binary",
      "name": "To Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// /images/generations отдаёт base64 — превращаем в бинарь для ответа вебхука.\nconst b64 = $json.data?.[0]?.b64_json;\nif (!b64) throw new Error('OpenAI не вернул картинку');\nreturn [{ json: {}, binary: { data: { data: b64, mimeType: 'image/png', fileName: 'image.png' } } }];"
      }
    },
    {
