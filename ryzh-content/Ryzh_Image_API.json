    },
    {
      "id": "Validate",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Разбор запроса рилсмейкера + дневной лимит (защита от зациклившегося агента).\nconst DAILY_LIMIT = 40;\nconst SPRITES = 'https://perevyazko1.github.io/n8n-fitness-scan/img/';\nconst LOCK = [\n  'The reference image shows Ryzh, our mascot. Draw the SAME character: identical head, face and eyes,',\n  'the same muscular athletic build, orange headband, orange wristbands, black sports shorts with an orange side stripe,',\n  'orange fur #E8763A with cream muzzle, chest and belly, fluffy tail with white tip, the same thick black outlines.',\n].join(' ');\nconst b = $json.body || {};\nconst fail = (code, error) => [{ json: { error, code } }];\n\nconst prompt = String(b.prompt || '').trim();\nif (prompt.length < 5) return fail(400, 'prompt обязателен');\nif (prompt.length > 4000) return fail(400, 'prompt длиннее 4000 знаков');\nconst size = b.size || '1024x1536';\nif (!['1024x1024', '1024x1536', '1536x1024', 'auto'].includes(size)) return fail(400, 'size: 1024x1024 | 1024x1536 | 1536x1024 | auto');\nconst quality = b.quality || 'medium';\nif (!['low', 'medium', 'high', 'auto'].includes(quality)) return fail(400, 'quality: low | medium | high | auto');\nconst background = b.background || '';\nif (background && !['transparent', 'opaque', 'auto'].includes(background)) return fail(400, 'background: transparent | opaque | auto');\n\n// ref: имя спрайта (fox_m2_b0 — по умолчанию), https-ссылка на картинку или 'none'.\nconst ref = b.ref === undefined ? 'fox_m2_b0' : String(b.ref);\nlet ref_url = '', isFox = false;\nif (/^fox_m[0-3]_b[0-3]$/.test(ref)) { ref_url = `${SPRITES}${ref}.png`; isFox = true; }\nelse if (/^https:\\/\\//.test(ref)) ref_url = ref;\nelse if (ref !== 'none') return fail(400, 'ref: fox_m{0-3}_b{0-3} | https://… | none');\n\nconst s = $getWorkflowStaticData('global');\nconst day = new Date().toISOString().slice(0, 10);\nif (s.day !== day) { s.day = day; s.count = 0; }\nif (s.count >= DAILY_LIMIT) return fail(429, `дневной лимит ${DAILY_LIMIT} картинок исчерпан`);\ns.count += 1;\n\n// Эталон Рыжа без замка внешности модель перерисовывает «каким-то лисом» — замок добавляем,\n// если агент сам не попросил raw.\nconst full = isFox && !b.raw ? `${LOCK} ${prompt}` : prompt;\nreturn [{ json: { prompt: full, size, quality, background, ref_url, used: s.count, limit: DAILY_LIMIT } }];"
      }
    },
