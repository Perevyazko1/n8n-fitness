      ],
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "data",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "X-Images-Used",
                "value": "={{ $('Validate').first().json.used }}/{{ $('Validate').first().json.limit }}"
              }
            ]
          }
        }
      }
    },
    {
